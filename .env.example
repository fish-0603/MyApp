# 複製這個檔案為 .env 並填入實際值。.env 不會被提交到版本控制。

# Google Maps 的 Android API Key，供 app.config.js 在 build 時注入
# android.config.googleMaps.apiKey（AndroidManifest.xml 的 meta-data）
GOOGLE_MAPS_API_KEY=

# 正式打包後端 API 網址。開發模式（expo start）下可留空，
# 會自動偵測 Expo dev server 所在電腦的區網 IP；正式打包（release/生產環境）必填，
# 否則 App 會在 console 印出錯誤且無法連線到後端。
EXPO_PUBLIC_API_BASE_URL=
